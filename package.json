{
  "name": "drunk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "SKIP_EMULATOR_CHECK=1 vitest run src/lib/alcohol.test.ts src/lib/party.test.ts src/lib/roster.test.ts src/lib/onboarding.test.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:emulators": "firebase emulators:exec --only auth,firestore \"npm run test\"",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:exec": "firebase emulators:exec --only auth,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
